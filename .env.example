APP_NAME=Galaxy Core
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=galaxy_db
PGUSER=postgres
PGPASSWORD=CHANGE_ME

# Gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.8-flash

# Paso 38 — seguridad JWT
GALAXY_JWT_SECRET=GENERATE_WITH_scripts/paso39_security_setup.py
GALAXY_JWT_ALGORITHM=HS256
GALAXY_JWT_EXP_MINUTES=1440
GALAXY_JWT_ISSUER=galaxy-core

# Telegram local: configura token y Chat ID desde Dashboard > Canales.
# Estas variables solo se conservan para el webhook heredado; no son necesarias con Uvicorn/polling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BUSINESS_ID=

# Provisioning interno de negocios después de confirmar el pago. Dejar vacío en producción pública.
# Si se configura, enviar su valor solo como header X-Internal-Onboarding-Key desde una herramienta privada.
CALYRISIA_ONBOARDING_ADMIN_KEY=
# Administra aprobaciones de pagos manuales en /admin/contrataciones/. Genera una clave aleatoria de 32+ caracteres.
CALYRISIA_CHECKOUT_ADMIN_KEY=calyrisia_admin_2026_Jorgevg8_9f4b2c8e1d7a6f3b5c0e2a4d8f1b3c5e


