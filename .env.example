# Payment-card subscriptions via PayPal Billing Plans (monthly USD). Set mode=sandbox until tested.
# Create plans for $19, $49 and $99 USD/month in the same PayPal environment; copy each generated plan ID.
# Configure the webhook in the PayPal dashboard to POST to /api/v1/public/checkout/paypal/webhook.
# Subscribe the webhook to BILLING.SUBSCRIPTION.CREATED, BILLING.SUBSCRIPTION.ACTIVATED,
# BILLING.SUBSCRIPTION.UPDATED, BILLING.SUBSCRIPTION.CANCELLED, BILLING.SUBSCRIPTION.SUSPENDED,
# BILLING.SUBSCRIPTION.EXPIRED, and PAYMENT.SALE.COMPLETED.
CALYRISIA_PAYPAL_MODE=sandbox
CALYRISIA_PAYPAL_CLIENT_ID=
CALYRISIA_PAYPAL_CLIENT_SECRET=
CALYRISIA_PAYPAL_WEBHOOK_ID=
CALYRISIA_PAYPAL_PLAN_ID_EMPRENDEDOR=
CALYRISIA_PAYPAL_PLAN_ID_SMART_BUSINESS=
CALYRISIA_PAYPAL_PLAN_ID_ENTERPRISE=
