APP_NAME=Galaxy Core
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://calyrisia.com

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=galaxy_db
PGUSER=postgres
PGPASSWORD=CHANGE_ME
PGSSLMODE=require

# Gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash

# Paso 38 — seguridad JWT
GALAXY_JWT_SECRET=GENERATE_WITH_scripts/paso39_security_setup.py
GALAXY_JWT_ALGORITHM=HS256
GALAXY_JWT_EXP_MINUTES=1440
GALAXY_JWT_ISSUER=galaxy-core

# Evolution API (WhatsApp Multitenant / QR Dinámico por tenant_id)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_URL=https://calyrisia.com/api/webhooks/whatsapp
WA_PROVIDER=auto

# Meta Graph API & OAuth oficial (Instagram Direct y Facebook Messenger)
# Nunca publiques META_APP_SECRET ni META_WEBHOOK_VERIFY_TOKEN.
META_APP_ID=
META_APP_SECRET=
# Generate a random secret (32+ characters). Keep it stable or saved Meta tokens cannot be decrypted.
META_TOKEN_ENCRYPTION_KEY=
META_OAUTH_STATE_SECRET=
META_REDIRECT_URI=https://calyrisia.com/api/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
META_STRICT_SIGNATURE=true
META_GRAPH_API_VERSION=v26.0

# Telegram MTProto (inicio de sesión por número + código OTP)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BUSINESS_ID=

# Provisioning y administración de contrataciones
CALYRISIA_ONBOARDING_ADMIN_KEY=
CALYRISIA_CHECKOUT_ADMIN_KEY=

# CALYRISIA commercial checkout configuration
CALYRISIA_SALES_WHATSAPP=
CALYRISIA_SALES_EMAIL=
CALYRISIA_PAGO_MOVIL_BANK=
CALYRISIA_PAGO_MOVIL_PHONE=
CALYRISIA_PAGO_MOVIL_ID=
CALYRISIA_BINANCE_USER=
CALYRISIA_BINANCE_PAY_ID=
CALYRISIA_BINANCE_PAY_EMAIL=
CALYRISIA_BINANCE_NETWORK=
CALYRISIA_BINANCE_QR_IMAGE_URL=/payments/binance-pay-qr.png
CALYRISIA_BINANCE_PAYMENT_URL=
CALYRISIA_ZINLI_ID=
CALYRISIA_ZINLI_EMAIL=
CALYRISIA_ZINLI_PAYMENT_URL=
CALYRISIA_PAYPAL_MODE=sandbox
CALYRISIA_PAYPAL_CLIENT_ID=
CALYRISIA_PAYPAL_CLIENT_SECRET=
CALYRISIA_PAYPAL_WEBHOOK_ID=
CALYRISIA_PAYPAL_PLAN_ID_EMPRENDEDOR=
CALYRISIA_PAYPAL_PLAN_ID_SMART_BUSINESS=
CALYRISIA_PAYPAL_PLAN_ID_ENTERPRISE=
